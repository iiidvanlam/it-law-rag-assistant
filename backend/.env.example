DATABASE_URL=postgresql+psycopg2://postgres:password@127.0.0.1:5433/law_db
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_CHAT_MODEL=deepseek/deepseek-chat
LLM_MAX_TOKENS=2048

# Google Sign-In OAuth 2.0 (Google Identity Services - Web Client ID)
